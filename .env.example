DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sessionly_server?schema=public"
# Optional. Default page size when `take` is omitted on paginated repository calls (fallback: 10).
# PAGINATION_DEFAULT_TAKE=20
PORT=3002
HOST=localhost
NODE_ENV=development

# Auth (Passport + JWT). Access token payload is only `{ sub: userId }`.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN=15m
# Number of days until refresh tokens expire (stored hashed in the database).
JWT_REFRESH_EXPIRES_DAYS=7
